{
  "name": "scrcd",
  "private": true,
  "version": "1.3.1",
  "license": "MIT",
  "description": "Step-by-Step SOP & Guide Creator",
  "author": "SCRCD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node tests/exportTest.js && node tests/masterBinderTest.js",
    "build:tools": "powershell -ExecutionPolicy Bypass -File tools/build-tools.ps1",
    "build:exe": "npm run build && electron-builder --win portable",
    "build:installer": "npm run build && electron-builder --win nsis",
    "build:all": "npm run build && electron-builder --win portable nsis",
    "release": "node scripts/release.cjs",
    "tauri": "tauri",
    "electron:dev": "electron ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.2.0",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/extension-table": "^2.11.5",
    "@tiptap/extension-table-cell": "^2.11.5",
    "@tiptap/extension-table-header": "^2.11.5",
    "@tiptap/extension-table-row": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "clsx": "^2.1.1",
    "docx": "^9.2.0",
    "gifenc": "^1.0.3",
    "jszip": "^3.10.1",
    "konva": "^9.3.18",
    "lucide-react": "^1.16.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.scrcd.app",
    "productName": "SCRCD",
    "copyright": "Copyright © 2026 SCRCD",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "bin/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SCRCD",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
